# MFMS Preview frontend configuration.
# Copy to a local ignored environment file and replace placeholders locally.

HARVEST_API_BASE_URL=http://127.0.0.1:8001
HARVEST_API_USERNAME=replace_with_preview_api_username
HARVEST_API_PASSWORD=replace_with_preview_api_password

MFMS_ENV=preview
MFMS_TARGET_DATABASE=mfms_server_uat
MFMS_ENABLE_PREVIEW_HARVEST_CYCLE_WRITES=false
MFMS_LOCAL_TILE_ROOT=/replace/with/server/map-tile/root

# Worker Management browser requests are proxied through the Next.js BFF.
# Use the same 32+ character secret in the frontend and backend environments.
MFMS_ACTOR_ASSERTION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Enable only behind the authenticated MFMS proxy; it must strip and overwrite
# X-MFMS-User, X-MFMS-Role, and X-MFMS-Environment from public requests.
MFMS_TRUST_PROXY_ACTOR_HEADERS=true
# Preview currently grants the authenticated MFMS gateway user administrator
# rights. Change this server-side value to manager or viewer where required.
MFMS_WORKER_PROXY_DEFAULT_ROLE=admin

# Local actor fallback is for disposable local development only. Keep it off in Preview/Production.
MFMS_WORKER_LOCAL_ACTOR_ENABLED=false
MFMS_WORKER_LOCAL_ACTOR_USERNAME=
MFMS_WORKER_LOCAL_ACTOR_ROLE=admin

NEXT_PUBLIC_MFMS_ENV=Preview
NEXT_PUBLIC_MFMS_ENV_BANNER=PREVIEW / UAT
NEXT_PUBLIC_MFMS_ENV_DATABASE_LABEL=mfms_server_uat

# Supplied by the immutable image build.
MFMS_GIT_COMMIT=unknown
MFMS_BUILD_TIMESTAMP=unknown
MFMS_BUILD_ENVIRONMENT=Preview
